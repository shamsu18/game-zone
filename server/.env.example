# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database =====
# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/gamezone_bd

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Seed admin (used by `npm run seed`) =====
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@gamezone.bd
ADMIN_PHONE=017000000000
ADMIN_PASSWORD=admin1234

# ===== Client (for CORS) =====
CLIENT_URL=http://localhost:5173

# ===== Image uploads (local by default) =====
# Set to "cloudinary" to use Cloudinary, otherwise images are stored locally in /uploads
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Payments (mock for MVP) =====
# Set to "mock" for the mocked mark-as-paid flow, or "sslcommerz" / "bkash" for real sandbox
PAYMENT_PROVIDER=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
